# CollegeFootballData.com  -- free key: https://collegefootballdata.com/key
CFBD_API_KEY=

# Kalshi trading API (market data + EV table). https://kalshi.com -> Account -> API Keys
# KALSHI_PRIVATE_KEY_PATH points at the RSA private key .pem Kalshi gives you on key creation.
KALSHI_ACCESS_KEY=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2

# Where parquet/sqlite caches live (default: ./data)
CFB_DATA_DIR=
